# VPS Pilot hub configuration. Copy to server/.env and adjust.
# Real environment variables take precedence over this file.

# Login session (JWT). Use a long random string: openssl rand -hex 32
TOKEN_SECRET=
# Session lifetime in minutes (10080 = 7 days)
TOKEN_LIFESPAN=10080

# Auth cookie Secure flag. Unset = automatic (Secure when served over HTTPS,
# including behind a proxy that sets X-Forwarded-Proto). Set true/false to force.
COOKIE_SECURE=

# Where the SQLite databases and the agent TLS cert (tls/) live.
# Back this directory up: losing tls/ means re-enrolling every agent.
DB_PATH=./data

# Agent channel port (overridden by the -agent-port flag)
TCP_SERVER_PORT=55001

# SMTP for email alerts (optional)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
