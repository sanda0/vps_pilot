# Directory where SQLite creates operational.db and timeseries.db
DB_PATH=./data

# JWT authentication
TOKEN_LIFESPAN=60
TOKEN_SECRET=replace-with-a-secure-random-secret

# TCP port used by VPS Pilot agents
TCP_SERVER_PORT=55001
# Shared secret required from agents; use a long random value in production
AGENT_TOKEN=

# Optional email alerts
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
